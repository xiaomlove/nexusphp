server {
    listen 443 ssl;
    http2 on;
    server_name ${NP_DOMAIN};

    root /var/www/html/public;
    index index.php index.html;

    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/private.key;

    client_max_body_size 100M;

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /nexus.php?$query_string;
    }

    # Filament
    location ^~ /filament {
        try_files $uri $uri/ /nexus.php$is_args$args;
    }

    # Phase 2 legacy-migration routes — each URL listed here was a
    # `public/<page>.php` file that has been deleted in favour of a
    # Laravel controller (see `routes/web.php`). The exact-match
    # `location =` rules win against the catch-all `location ~
    # \.php$` below, so these URLs go to nexus.php instead of
    # fastcgi'ing the (now missing) file.
    location = /thanks.php {
        try_files /nonexistent @nexus_app;
    }

    location = /special.php {
        try_files /nonexistent @nexus_app;
    }

    location = /preview.php {
        try_files /nonexistent @nexus_app;
    }

    location = /searchsuggest.php {
        try_files /nonexistent @nexus_app;
    }

    location = /suggest.php {
        try_files /nonexistent @nexus_app;
    }

    location = /opensearch.php {
        try_files /nonexistent @nexus_app;
    }

    location = /ok.php {
        try_files /nonexistent @nexus_app;
    }

    location = /takecontact.php {
        try_files /nonexistent @nexus_app;
    }

    location = /takestaffmess.php {
        try_files /nonexistent @nexus_app;
    }

    location = /takeupdate.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #2 — legacy migration routes.
    location = /logout.php {
        try_files /nonexistent @nexus_app;
    }

    location = /image.php {
        try_files /nonexistent @nexus_app;
    }

    location = /bookmark.php {
        try_files /nonexistent @nexus_app;
    }

    # `confirmemail.php` carries three positional path segments (id /
    # md5 / email). A prefix match is needed because `location =` only
    # matches exact URIs.
    location ^~ /confirmemail.php/ {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #3 — legacy migration routes.
    location = /moresmilies.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #4 — legacy migration routes.
    location = /smilies.php {
        try_files /nonexistent @nexus_app;
    }

    location = /allagents.php {
        try_files /nonexistent @nexus_app;
    }

    location = /clearcache.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #5 — legacy migration routes.
    location = /contactstaff.php {
        try_files /nonexistent @nexus_app;
    }

    location = /donated.php {
        try_files /nonexistent @nexus_app;
    }

    location = /takeflush.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #6 — legacy migration routes.
    location = /bannedemails.php {
        try_files /nonexistent @nexus_app;
    }

    location = /allowedemails.php {
        try_files /nonexistent @nexus_app;
    }

    location = /nowarn.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #7 — legacy migration routes.
    location = /freeleech.php {
        try_files /nonexistent @nexus_app;
    }

    location = /deletedisabled.php {
        try_files /nonexistent @nexus_app;
    }

    location = /delacctadmin.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #8 — legacy migration routes.
    location = /rules.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #9 — legacy migration routes.
    location = /donorlist.php {
        try_files /nonexistent @nexus_app;
    }

    location = /mailtest.php {
        try_files /nonexistent @nexus_app;
    }

    location = /adduser.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #10 — legacy migration routes.
    location = /getextinfoajax.php {
        try_files /nonexistent @nexus_app;
    }

    # Phase 2 batch #11 — legacy migration routes.
    location = /user-ban-log.php {
        try_files /nonexistent @nexus_app;
    }

    location = /takereseed.php {
        try_files /nonexistent @nexus_app;
    }

    location = /takeconfirm.php {
        try_files /nonexistent @nexus_app;
    }

    location = /getattachment.php {
        try_files /nonexistent @nexus_app;
    }

    location = /downloadsubs.php {
        try_files /nonexistent @nexus_app;
    }

    location = /docleanup.php {
        try_files /nonexistent @nexus_app;
    }

    location = /unco.php {
        try_files /nonexistent @nexus_app;
    }


    # Phase 3 — legacy migration routes (full rewrites).
    location = /magic.php {
        try_files /nonexistent @nexus_app;
    }

    location = /aboutnexus.php {
        try_files /nonexistent @nexus_app;
    }


    location @nexus_app {
        rewrite ^ /nexus.php last;
    }

    location = /announce.php {
        access_by_lua_block {
            local filter = require("tracker_filter")
            filter()
        }
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param REQUEST_ID $request_id;
    }

    location ~ \.php$ {
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param REQUEST_ID $request_id;
    }

}
