server {
    listen 443 ssl;
    http2 on;
    server_name ${NP_DOMAIN};

    root /var/www/html/public;
    index index.php index.html;

    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/private.key;

    client_max_body_size 100M;

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /nexus.php?$query_string;
    }

    # Filament
    location ^~ /filament {
        try_files $uri $uri/ /nexus.php$is_args$args;
    }

    # Phase 2 legacy-migration routes — each URL listed here was a
    # `public/<page>.php` file that has been deleted in favour of a
    # Laravel controller (see `routes/web.php`). The exact-match
    # `location =` rules win against the catch-all `location ~
    # \.php$` below, so these URLs go to nexus.php instead of
    # fastcgi'ing the (now missing) file.
    location = /thanks.php {
        try_files /nonexistent @nexus_app;
    }

    location = /special.php {
        try_files /nonexistent @nexus_app;
    }

    location = /preview.php {
        try_files /nonexistent @nexus_app;
